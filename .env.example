# Local Docker Compose (native development: set AUTH_APP_ORIGIN=http://localhost:5173)
APP_ENV=development
AUTH_APP_ORIGIN=http://localhost:8080
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_REGISTRATION=true
# Enable after configuring an authenticated SMTP sender; existing accounts then need proof.
# Also enables forgot-password recovery through the same SMTP sender.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PNBallie

# Production requires APP_ENV=production, an HTTPS origin, and secure cookies.
# Standard OIDC is optional; email/password works without an external provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Single sign-on

# Optional async avatars. Start docker compose --profile avatars up --build -d.
# Local service contract and Spark setup: docs/AVATAR_SERVICE.md
AVATAR_LOCAL_URL=
AVATAR_SERVICE_TOKEN=
# pixel-v1 uses the supplied body; legacy retains the two-model route.
AVATAR_LOCAL_STYLE=legacy
# Enable only with the updated private service /v1/status endpoint.
AVATAR_CHECK_CAPACITY=false
AVATAR_TIMEOUT_SECONDS=3600

# Optional cloud processing, selected by the operator.
# Server-selected provider. Qwen stays available through AVATAR_DEFAULT_PROVIDER=local.
# Optional native-development archive path; Compose uses /data/avatar-originals.
AVATAR_ORIGINALS_DIR=.local-data/avatar-originals
AVATAR_DEFAULT_PROVIDER=local
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Image deployment, separate from the chat/Responses AZURE_OPENAI_DEPLOYMENT.
AZURE_OPENAI_IMAGE_DEPLOYMENT=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=

# Optional operational telemetry; disabled for local development by default.
# Keep the collector and metrics endpoints private. See docs/OBSERVABILITY.md.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.monitoring.svc.cluster.local:4318
OTEL_TRACES_SAMPLER_ARG=0.1
DEPLOYMENT_ENVIRONMENT=development
METRICS_ENABLED=false

# Optional self-hosted Umami SPA analytics, configured when Nginx starts.
ANALYTICS_ENABLED=false
ANALYTICS_WEBSITE_ID=
ANALYTICS_UPSTREAM=umami.analytics.svc.cluster.local:3000
# Trust only the actual ingress proxy CIDRs; leave empty for direct/local access.
ANALYTICS_TRUSTED_PROXY_CIDRS=
